{
  "expo": {
    "name": "Stelar",
    "slug": "tracking-app",
    "scheme": "stelar",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "reactCompiler": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0608",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0608"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tatello.stelar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tatello.stelar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0608"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a Stelar usar la cámara para tomar tus fotos de progreso. Solo se usan dentro de la app y quedan privadas en tu cuenta."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Stelar acceder a tus fotos para elegir tu foto de perfil, registrar tus comidas y tus fotos de progreso. Solo se usan dentro de la app y quedan privadas en tu cuenta."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite a Stelar acceder a tus fotos para tu foto de perfil y tus fotos de progreso.",
          "savePhotosPermission": "Permite a Stelar guardar tus tarjetas de progreso en tu galería.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E91E63"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Stelar lee tus entrenos, tu sueño, tus pasos y el agua que registras para anotarlos por ti. Nada sale de tu cuenta.",
          "NSHealthUpdateUsageDescription": "Stelar no modifica tus datos de Salud. Solo los lee para anotar tus entrenos y tu sueño por ti.",
          "background": true
        }
      ],
      "./plugins/with-healthkit-background-observers.js",
      "expo-web-browser",
      "react-native-health-connect",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a44e4351-b3df-4462-8168-b28e1ac4d6a2"
      }
    },
    "owner": "tatello"
  }
}
