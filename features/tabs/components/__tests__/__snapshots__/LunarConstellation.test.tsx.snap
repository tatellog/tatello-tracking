            "transform": [
              {
                "translateY": -0,
              },
            ],
          },
        ]
      }
    >
      <Text
        style={
          {
            "color": "#E91E63",
            "fontFamily": "CormorantGaramond_600SemiBold_Italic",
            "fontSize": 22,
            "fontStyle": "italic",
            "textShadowColor": "rgba(233,30,99,0.5)",
            "textShadowOffset": {
              "height": 0,
              "width": 0,
            },
            "textShadowRadius": 12,
          }
        }
      >
        +1
      </Text>
    </View>
  </View>
</View>
`;
